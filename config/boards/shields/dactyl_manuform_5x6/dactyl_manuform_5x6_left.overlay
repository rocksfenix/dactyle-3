#include "dactyl_manuform_5x6.dtsi" // Notice that the main dtsi files are included in the overlay.
#include <dt-bindings/zmk/hid_indicators.h>

&kscan0 {
    col-gpios
        = <&gpio0 20 GPIO_ACTIVE_HIGH>
        , <&gpio0 22 GPIO_ACTIVE_HIGH>
        , <&gpio0 24 GPIO_ACTIVE_HIGH>
        , <&gpio1 0 GPIO_ACTIVE_HIGH>
        , <&gpio0 11 GPIO_ACTIVE_HIGH>
        , <&gpio1 4 GPIO_ACTIVE_HIGH>
        , <&gpio1 6 GPIO_ACTIVE_HIGH>
        ;
};

/ {
	// Green and blue are driven by src/dactyl_leds.c; red is Caps Lock below.
	aliases {
		dactyl-led-green = &green_led;
		dactyl-led-blue = &blue_led;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_green {
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			label = "Green (CP)";
		};

		red_led: led_red {
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			label = "Red (L1)";
		};

		blue_led: led_blue {
			gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
			label = "Blue (L2)";
		};
	};

	indicators {
		compatible = "zmk,indicator-leds";

		caps_lock_indicator: caps_lock {
			indicator = <HID_INDICATOR_CAPS_LOCK>;
			leds = <&red_led>;
		};
	};
};
